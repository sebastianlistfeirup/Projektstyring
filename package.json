{
  "name": "orbit",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n app,companion -c blue,magenta \"vite\" \"node server/companion.mjs\"",
    "dev:app": "vite",
    "companion": "node server/companion.mjs",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:imports": "tsx scripts/test-imports.ts",
    "test:ai": "node --test scripts/test-ai-*.mjs scripts/test-workspace-*.mjs",
    "test:workspace": "tsx --test scripts/test-workspace.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.29",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.19",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pkg": "^5.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
